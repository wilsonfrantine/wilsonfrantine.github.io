---
import { Code2, ChevronRight } from 'lucide-astro';
import ProjectShowcase from './ProjectShowcase.astro';
---

<section id="hero" class="relative min-h-screen flex items-center overflow-hidden px-6 bg-white dark:bg-slate-950 border-b border-slate-100 dark:border-white/5 transition-colors duration-300">
  
  <!-- Fundo Geek 2.0 -->
  <div class="hero-background-layer absolute inset-0 z-[1] flex pointer-events-none select-none overflow-hidden">
    <div class="hero-dna-background w-1/3 font-mono text-[14px] text-sky-500/10 dark:text-sky-500/15 leading-none break-all px-4 opacity-50">
      {Array.from({ length: 60 }).map(() => (
        <div class="mb-1 tracking-[0.5em] uppercase text-sky-900/10 dark:text-sky-400/20">
          {"ATGC".repeat(8).slice(0, -3)}
        </div>
      ))}
    </div>
    <div class="hero-code-background w-2/3 font-mono text-[12px] text-emerald-500/5 dark:text-emerald-400/8 leading-relaxed px-12 py-12">
      {Array.from({ length: 12 }).map((_, i) => (
        <div class="mb-12">
            <pre class="text-slate-200 dark:text-emerald-400/10">
{i % 2 === 0 ? `
# Filtering genomic variants
for variant in vcf.fetch('chr1', 1000, 2000):
    if variant.QUAL > 30:
        process_sample(variant.samples[0])
` : `
# Plotting allele frequencies
ggplot(aes(x=pos, y=freq)) + 
    geom_line(color="#0ea5e9") + 
    theme_minimal()
`}
            </pre>
        </div>
      ))}
    </div>
  </div>

  <ProjectShowcase />
  
  <div class="hero-foreground relative z-10 w-full">
    <div class="max-w-4xl pt-20 md:pt-0">
      <!-- Tag Contexto -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-slate-50 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-400 dark:text-slate-500 text-[10px] font-mono mb-10 uppercase tracking-[0.4em] rounded-full backdrop-blur-sm">
        <Code2 size={12} class="text-sky-500" /> [ sudo chmod +x ideas.sh ]
      </div>

      <!-- Título Terminal Style -->
      <h1 class="text-[clamp(2rem,4.8vw,4.5rem)] font-bold text-slate-900 dark:text-white mb-8 tracking-tight leading-[1.05] select-none font-mono">
          <span class="block">@TATAbox:</span>
          <span class="block text-sky-600 dark:text-sky-500">~/workspace$ <span class="animate-cursor">_</span></span>
      </h1>
      
      <div class="mb-10 max-w-2xl border-l border-slate-200 dark:border-white/10 pl-8 font-mono">
        <p class="text-xl md:text-2xl text-slate-600 dark:text-slate-400 leading-relaxed">
          Ferramentas, modelos e scripts para a amnésia do futuro...
        </p>
        <p class="mt-3 text-base md:text-lg italic tracking-tight text-slate-500 dark:text-slate-500">
          <span class="text-emerald-600 dark:text-emerald-500">if</span> <span class="text-sky-600 dark:text-sky-400">works</span> → intencional; <span class="text-amber-600 dark:text-amber-500">else</span> → feature em construção.
        </p>
      </div>

      <!-- Botões Modernos e Minimalistas -->
      <div class="flex w-full max-w-72 flex-col items-stretch gap-4">
        <a href="#projects" class="group relative inline-flex h-[42px] w-full items-center justify-center bg-slate-900 text-white dark:bg-white dark:text-slate-950 font-black text-xs uppercase tracking-[0.2em] transition-all hover:bg-sky-600 dark:hover:bg-sky-500 hover:shadow-[0_0_40px_rgba(14,165,233,0.3)]">
          <span class="relative z-10 flex items-center gap-2">
            Projetos e ferramentas <ChevronRight size={16} class="group-hover:translate-x-1 transition-transform" />
          </span>
        </a>
        <a href="#teaching" class="inline-flex h-[42px] w-full items-center justify-center border border-slate-200 dark:border-white/10 text-slate-500 dark:text-slate-400 font-bold text-xs uppercase tracking-[0.2em] hover:text-slate-900 dark:hover:text-white hover:border-sky-500/50 hover:bg-slate-50 dark:hover:bg-white/2 transition-all backdrop-blur-sm">
          Materiais e referências
        </a>
        <a href="#research" class="inline-flex h-[42px] w-full items-center justify-center border border-slate-200 dark:border-white/10 text-sky-600 dark:text-sky-400 font-bold text-xs uppercase tracking-[0.2em] hover:text-slate-900 dark:hover:text-white hover:border-sky-500/50 hover:bg-slate-50 dark:hover:bg-white/2 transition-all backdrop-blur-sm">
          Pesquisa e publicações
        </a>
      </div>
    </div>
  </div>

  <!-- Assinatura Vertical (Absolute/Fixa) -->
  <div class="hidden lg:block absolute right-12 top-1/2 -translate-y-1/2 vertical-text font-mono text-[10px] text-slate-300 dark:text-slate-800 tracking-[0.6em] uppercase select-none transition-colors duration-300">
    Wilson Frantine-Silva // root@TATAbox // Bio+Info
  </div>
</section>

<style>
  .hero-foreground {
    max-width: 80rem;
    margin-inline: auto;
  }

  @media (min-width: 1024px) {
    .hero-foreground {
      width: 50vw;
      max-width: none;
      margin-left: max(0px, calc((100vw - 80rem) / 2 - 1.5rem));
      margin-right: 0;
    }
  }

  .vertical-text {
    writing-mode: vertical-rl;
    text-orientation: mixed;
  }

  .animate-cursor {
    animation: blink 1.2s step-end infinite;
  }

  @keyframes blink {
    from, to { opacity: 1; }
    50% { opacity: 0; }
  }

</style>
